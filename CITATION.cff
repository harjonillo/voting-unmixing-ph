    given-names: Hannah
    affiliation: >-
      CX Team, Instrumentation Physics Laboratory, National Institute of
      Physics, University of the Philippines Diliman
  - family-names: Lim
    given-names: May
    affiliation: >-
      CX Team, Instrumentation Physics Laboratory, National Institute of
      Physics, University of the Philippines Diliman
repository-code: "https://github.com/harjonillo/voting-unmixing-ph"
url: "https://harjonillo.github.io/voting-unmixing-ph/"
license: MIT
keywords:
  - hyperspectral unmixing
  - spectral unmixing
  - elections
  - Philippines
  - voting behavior
