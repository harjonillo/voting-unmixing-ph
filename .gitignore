# Data (copied from 2025-PH-elections / BSthesis-main-2; see data/README.md)
data/*
!data/README.md

# ...but the static-site build needs these two trees committed so the GitHub
# Pages build can bake them. Re-included here, then the heavy files the build
# never reads are excluded again below. (See scripts/build_static.py.)
!data/processed/
!data/shapefiles/
# per-p full-resolution abundances: only used when full_resolution=True, which
# the app never sets — ~32 MB the browser would otherwise download for nothing
data/processed/*/sweep/*/abundances_ref.parquet
# region shapefile: referenced in config.ini but never loaded (regions are
# built by dissolving provinces)
data/shapefiles/regions/
# unused alternative boundary source
data/shapefiles/gadm41_PHL_2.json.zip

# generated static FastHTML site (data baked by scripts/build_static.py, shell
# by scripts/build_site.py — rebuilt in CI from the committed data/ trees)
/site/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# OS / editors
.DS_Store
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml
